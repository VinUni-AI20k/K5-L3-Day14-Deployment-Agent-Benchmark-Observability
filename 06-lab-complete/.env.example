# ============================================================
# Mẫu biến môi trường (tiêu chí 9)
# KHÔNG ghi secret thật vào file này.
# Dùng:  cp .env.example .env   rồi điền giá trị thật vào .env
# File .env đã nằm trong .gitignore và .dockerignore.
# ============================================================

# Server
PORT=8000
ENVIRONMENT=development

# Bảo vệ API — đặt key thật khi chạy/deploy. Để trống = từ chối mọi request.
AGENT_API_KEY=

# Redis — rate limit và cost guard lưu ở đây
# (docker compose tự đặt REDIS_URL=redis://redis:6379/0, không cần sửa)
REDIS_URL=redis://localhost:6379/0

# Rate limit: số request tối đa mỗi API key trong 60 giây
RATE_LIMIT_PER_MINUTE=10

# Cost guard: ngân sách LLM tối đa mỗi ngày (USD)
DAILY_BUDGET_USD=1.0
